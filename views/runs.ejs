<%- include("partials/header", { title: "Runs · Career Firm" }) %>
<% const fmt = (value) => String(value || "").slice(0, 16).replace("T", " "); %>
<h1>Audit trail</h1>
<p class="lead">
  Every workflow and model call is recorded locally. This is the firm's paper trail:
  what was asked, which role answered, how many tokens it used, and what it returned.
</p>

<h2>Workflows</h2>
<% if (workflows && workflows.length) { %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>#</th><th>Kind</th><th>Title</th><th>Status</th><th>Created</th><th></th></tr></thead>
    <tbody>
    <% for (const wf of workflows) { %>
      <tr>
        <td><%= wf.id %></td>
        <td><span class="badge"><%= wf.kind %></span></td>
        <td><%= wf.title %></td>
        <td><span class="badge <%= wf.status %>"><%= wf.status %></span></td>
        <td class="small muted"><%= fmt(wf.created_at) %></td>
        <td>
          <% if (wf.input && wf.input.job_id) { %>
            <a class="small" href="/jobs/<%= wf.input.job_id %>">Open job →</a>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty">No workflows recorded yet.</div>
<% } %>

<h2>Agent calls</h2>
<% if (agent_runs && agent_runs.length) { %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>#</th><th>Role</th><th>Workflow</th><th>Status</th><th>Provider / model</th><th>Tokens</th><th>Started</th></tr></thead>
    <tbody>
    <% for (const run of agent_runs) { %>
      <tr>
        <td><%= run.id %></td>
        <td><strong><%= run.role %></strong></td>
        <td class="small muted"><%= run.workflow %></td>
        <td><span class="badge <%= run.status %>"><%= run.status %></span></td>
        <td class="small muted"><%= run.provider %> / <%= run.model %></td>
        <td class="small muted"><%= run.prompt_tokens %> + <%= run.completion_tokens %></td>
        <td class="small muted"><%= fmt(run.created_at) %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } else { %>
<div class="empty">No agent calls yet. Tailor a CV to create the first audit record.</div>
<% } %>
<%- include("partials/footer") %>
