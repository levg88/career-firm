<%- include("partials/header", { title: (editing ? "Settings" : "Setup") + " · Career Firm" }) %>
<h1><%= editing ? "Settings" : "Set up Career Firm" %></h1>
<p class="lead">
  <% if (editing) { %>
  Change the model provider, API key, defaults, or imports. Everything is stored locally.
  <% } else { %>
  No config file needed. Answer a few questions once, then the firm is ready. Everything is
  stored in your local database on this machine.
  <% } %>
</p>

<form method="post" action="<%= editing ? "/settings" : "/setup" %>" enctype="multipart/form-data">
  <section class="card">
    <h2 style="margin-top: 0;">Model provider</h2>
    <p class="small muted">
      Choose how the agents think. Offline mode works without a key; a real provider gives
      much stronger analysis and writing.
    </p>

    <!-- Quick toggle: Local Ollama vs Online OpenCode -->
    <div style="margin-bottom: 18px; padding: 12px; background: #f8f9fb; border-radius: 10px; border: 1px solid var(--line);">
      <label style="font-weight: 600; font-size: 13px; margin-bottom: 8px; display: block;">Quick mode toggle</label>
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <label style="display: flex; gap: 6px; align-items: center; font-weight: 500; cursor: pointer;">
          <input type="radio" name="quick_mode" value="ollama" <%= settings.provider === 'ollama' ? 'checked' : '' %> style="width: auto;">
          🖥 Local Ollama (self-hosted)
        </label>
        <label style="display: flex; gap: 6px; align-items: center; font-weight: 500; cursor: pointer;">
          <input type="radio" name="quick_mode" value="opencode" <%= settings.provider === 'opencode' ? 'checked' : '' %> style="width: auto;">
          ☁ Online OpenCode (free/paid models)
        </label>
        <label style="display: flex; gap: 6px; align-items: center; font-weight: 500; cursor: pointer;">
          <input type="radio" name="quick_mode" value="mock" <%= settings.provider === 'mock' ? 'checked' : '' %> style="width: auto;">
          🔌 Offline (no key)
        </label>
      </div>
      <p class="small muted" style="margin: 8px 0 0;">
        Selecting a mode auto-fills the provider, base URL, and model fields below.
        Use the advanced section for fine-grained control.
      </p>
    </div>

    <div class="row">
      <div class="field">
        <label for="provider">Provider</label>
        <select id="provider" name="provider">
          <% for (const entry of providers) { const value = entry[0]; const label = entry[1]; %>
          <option value="<%= value %>" <%= settings.provider === value ? "selected" : "" %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label for="model">Model</label>
        <input id="model" type="text" name="model" value="<%= settings.model %>" placeholder="deepseek-v4.1-flash-free">
      </div>
      <div class="field">
        <label for="default_language">Default output language</label>
        <input id="default_language" type="text" name="default_language" value="<%= settings.defaultLanguage %>" placeholder="en">
      </div>
    </div>

    <!-- Ollama-specific fields (shown when provider is ollama) -->
    <div id="ollama-fields" style="display: <%= settings.provider === 'ollama' ? 'block' : 'none' %>;">
      <div class="row">
        <div class="field">
          <label for="ollama_base_url">Ollama server URL</label>
          <input id="ollama_base_url" type="text" name="ollama_base_url" value="<%= settings.ollamaBaseUrl %>" placeholder="http://localhost:11434/v1">
          <p class="small muted" style="margin: 5px 0 0;">
            Point to your local Ollama instance. Default: http://localhost:11434/v1
          </p>
        </div>
        <div class="field">
          <label for="ollama_model">Ollama model name</label>
          <input id="ollama_model" type="text" name="ollama_model" value="<%= settings.provider === 'ollama' ? settings.model : '' %>" placeholder="qwen2.5-coder:14b">
          <p class="small muted" style="margin: 5px 0 0;">
            E.g. beam-free, qwen2.5-coder:14b, deepseek-v4.1-flash-free:latest
          </p>
        </div>
      </div>
    </div>

    <!-- OpenCode-specific fields (shown when provider is opencode) -->
    <div id="opencode-fields" style="display: <%= settings.provider === 'opencode' ? 'block' : 'none' %>;">
      <div class="row">
        <div class="field">
          <label for="opencode_api_key">OpenCode API key</label>
          <input id="opencode_api_key" type="password" name="opencode_api_key" autocomplete="new-password"
                 placeholder="<%= settings.opencodeApiKey ? 'Current: ' + settings.opencodeApiKey.slice(0,4) + '…' + settings.opencodeApiKey.slice(-4) + ' — leave blank to keep' : 'Paste your OpenCode API key' %>">
          <p class="small muted" style="margin: 5px 0 0;">
            Required for online OpenCode models. Leave blank to keep current key.
          </p>
        </div>
        <div class="field">
          <label for="opencode_base_url">OpenCode server URL</label>
          <input id="opencode_base_url" type="text" name="opencode_base_url" value="<%= settings.opencodeBaseUrl %>" placeholder="https://opencode.ai/inference/openai/v1">
          <p class="small muted" style="margin: 5px 0 0;">
            Default: https://opencode.ai/inference/openai/v1
          </p>
        </div>
      </div>
      <div class="field">
        <label for="opencode_model">OpenCode model name</label>
        <input id="opencode_model" type="text" name="opencode_model" value="<%= settings.provider === 'opencode' ? settings.model : '' %>" placeholder="deepseek-v4.1-flash-free">
        <p class="small muted" style="margin: 5px 0 0;">
          E.g. deepseek-v4.1-flash-free, big-pickle, beam-free, glm-5.3-flash-free
        </p>
      </div>
    </div>

    <!-- Generic API key / base URL (for other providers) -->
    <div id="generic-fields" style="display: <%= ['openai', 'anthropic'].includes(settings.provider) ? 'block' : 'none' %>;">
      <div class="row">
        <div class="field">
          <label for="api_key">API key</label>
          <input id="api_key" type="password" name="api_key" autocomplete="new-password"
                 placeholder="<%= settings.apiKeyHint ? "Current: " + settings.apiKeyHint + " — leave blank to keep" : "Paste your provider API key" %>">
          <p class="small muted" style="margin: 5px 0 0;">
            Leave blank to keep the current key. Required for OpenAI, Anthropic and
            OpenCode; not used by Ollama or Offline mode.
          </p>
        </div>
        <div class="field">
          <label for="base_url">Base URL <span class="muted">(optional)</span></label>
          <input id="base_url" type="text" name="base_url" value="<%= base_url %>" placeholder="https://api.openai.com/v1">
          <p class="small muted" style="margin: 5px 0 0;">
            Change this for OpenRouter, vLLM, a proxy, or a self-hosted Ollama endpoint.
          </p>
        </div>
      </div>
    </div>

    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
      <input type="checkbox" name="clear_key" style="width: auto;">
      Clear the saved key for this provider
    </label>

    <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
      <input type="checkbox" name="clear_key" style="width: auto;">
      Clear the saved key for this provider
    </label>

    <details>
      <summary>Advanced model settings</summary>
      <div class="row" style="margin-top: 12px;">
        <div class="field">
          <label for="temperature">Temperature</label>
          <input id="temperature" type="text" name="temperature" value="<%= settings.temperature %>">
        </div>
        <div class="field">
          <label for="max_tokens">Max tokens per call</label>
          <input id="max_tokens" type="text" name="max_tokens" value="<%= settings.maxTokens %>">
        </div>
        <div class="field">
          <label for="max_agent_steps">Max agent steps</label>
          <input id="max_agent_steps" type="text" name="max_agent_steps" value="<%= settings.maxAgentSteps %>">
        </div>
        <div class="field">
          <label for="max_upload_mb">Max upload size (MB)</label>
          <input id="max_upload_mb" type="text" name="max_upload_mb" value="<%= settings.maxUploadMb %>">
        </div>
      </div>
      <div class="field">
        <label for="font_path">Custom PDF font path <span class="muted">(optional)</span></label>
        <input id="font_path" type="text" name="font_path" value="<%= settings.fontPath %>" placeholder="/System/Library/Fonts/Supplemental/Arial Unicode.ttf">
      </div>
      <label style="display: flex; gap: 8px; align-items: center; font-weight: 500;">
        <input type="checkbox" name="allow_heuristic_fallback" style="width: auto;"
               <%= settings.allowHeuristicFallback ? "checked" : "" %>>
        Fall back to deterministic offline agents if a model call fails
      </label>
    </details>
  </section>

  <section class="card" style="margin-top: 16px;">
    <h2 style="margin-top: 0;">Your source material</h2>
    <p class="small muted">
      Optional now. The firm only uses facts from this context and your CV versions.
      <% if (cvs && cvs.length) { %>You already have <%= cvs.length %> CV version<%= cvs.length === 1 ? "" : "s" %> imported.<% } %>
    </p>

    <div class="field">
      <label for="context_text">Context brief</label>
      <textarea id="context_text" name="context_text" placeholder="Target roles, differentiators, industries, constraints, compensation direction…"><%= profile.context_text %></textarea>
    </div>
    <div class="field">
      <label for="context_file">…or upload a context file (DOCX, PDF, TXT, MD)</label>
      <input id="context_file" type="file" name="context_file" accept=".docx,.pdf,.txt,.md,.markdown">
    </div>

    <div class="row">
      <div class="field">
        <label for="cv_file">Add a CV version (DOCX, PDF, TXT, MD)</label>
        <input id="cv_file" type="file" name="cv_file" accept=".docx,.pdf,.txt,.md,.markdown">
      </div>
      <div class="field">
        <label for="vertical">Vertical label</label>
        <input id="vertical" type="text" name="vertical" placeholder="AI Platforms">
      </div>
    </div>
    <p class="small muted">
      A LinkedIn “Save to PDF” profile export works, but a proper CV file produces better
      structure and tailoring. You can add more versions later under Profile.
    </p>
  </section>

  <div class="banner" style="margin-top: 16px;">
    <strong>Privacy:</strong> API keys are stored only in the local SQLite database
    (file permissions <span class="mono">0600</span>) and are sent only to the provider you
    choose. Do not expose this server to untrusted networks.
  </div>

  <div style="margin-top: 16px; display: flex; gap: 10px; align-items: center;">
    <button type="submit"><%= editing ? "Save settings" : "Save and open the firm" %></button>
    <span class="small muted">You can change all of this later in Settings.</span>
  </div>
</form>

<script>
  const modelSuggestions = <%- JSON.stringify(suggested_models || {}) %>;
  const baseSuggestions = <%- JSON.stringify(suggested_base_urls || {}) %>;

  function toggleFields() {
    const provider = document.getElementById("provider").value;
    document.getElementById("ollama-fields").style.display = provider === "ollama" ? "block" : "none";
    document.getElementById("opencode-fields").style.display = provider === "opencode" ? "block" : "none";
    document.getElementById("generic-fields").style.display = ["openai", "anthropic"].includes(provider) ? "block" : "none";

    // Sync model field from provider-specific inputs
    const ollamaModel = document.getElementById("ollama_model");
    const opencodeModel = document.getElementById("opencode_model");
    const model = document.getElementById("model");
    if (provider === "ollama" && ollamaModel && ollamaModel.value) {
      model.value = ollamaModel.value;
    } else if (provider === "opencode" && opencodeModel && opencodeModel.value) {
      model.value = opencodeModel.value;
    }
  }

  // Quick mode toggle
  document.querySelectorAll('input[name="quick_mode"]').forEach((radio) => {
    radio.addEventListener("change", (e) => {
      const provider = document.getElementById("provider");
      provider.value = e.target.value;
      // Sync model and base_url
      const model = document.getElementById("model");
      const baseUrl = document.getElementById("base_url");
      if (e.target.value === "ollama") {
        model.value = "qwen2.5-coder:14b";
        baseUrl.value = "http://localhost:11434/v1";
      } else if (e.target.value === "opencode") {
        model.value = "deepseek-v4.1-flash-free";
        baseUrl.value = "https://opencode.ai/inference/openai/v1";
      } else {
        model.value = "mock";
        baseUrl.value = "";
      }
      toggleFields();
    });
  });

  document.getElementById("provider").addEventListener("change", () => {
    const knownModels = Object.values(modelSuggestions);
    const model = document.getElementById("model");
    const baseUrl = document.getElementById("base_url");
    if (!model.value || knownModels.includes(model.value)) {
      model.value = modelSuggestions[document.getElementById("provider").value] || "";
    }
    const knownBases = Object.values(baseSuggestions);
    if (!baseUrl.value || knownBases.includes(baseUrl.value)) {
      baseUrl.value = baseSuggestions[document.getElementById("provider").value] || "";
    }
    toggleFields();
  });

  // Sync provider-specific model fields to main model field
  document.getElementById("ollama_model")?.addEventListener("input", (e) => {
    if (document.getElementById("provider").value === "ollama") {
      document.getElementById("model").value = e.target.value;
    }
  });
  document.getElementById("opencode_model")?.addEventListener("input", (e) => {
    if (document.getElementById("provider").value === "opencode") {
      document.getElementById("model").value = e.target.value;
    }
  });

  // Initialize
  toggleFields();
</script>
<%- include("partials/footer") %>
